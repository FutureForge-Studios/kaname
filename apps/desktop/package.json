{
  "name": "@kaname/desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Kaname Desktop \u2014 a Tauri client for Kaname panels",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
