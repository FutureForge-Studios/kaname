{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": [
    "NODE_ENV",
    "KANAME_ENV",
    "DATABASE_URL",
    "KANAME_MASTER_KEY",
    "KANAME_CONTROL_PLANE_URL",
    "KANAME_YUNORI_FEED",
    "KANAME_YUNORI_VERSION",
    "PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "bin/**",
        "../../agent/methods.json"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  },
  "globalPassThroughEnv": [
    "HOME",
    "USERPROFILE",
    "LOCALAPPDATA",
    "APPDATA",
    "CARGO_HOME",
    "CARGO_TARGET_DIR",
    "RUSTUP_HOME",
    "RUSTFLAGS",
    "KANAMED_VERSION",
    "SYSTEMROOT",
    "TEMP",
    "TMP"
  ]
}
