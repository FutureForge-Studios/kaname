# ------------------------------------------------------------------
# Kaname — environment
#
# Copy to .env for local development. `pnpm dev` works with every value
# below commented out; the defaults are the development ones.
# ------------------------------------------------------------------

KANAME_ENV=development

# --- database -----------------------------------------------------
# Development: PGlite, a real Postgres compiled to WASM. Nothing to
# install, no Docker, works on Windows (KD-004).
DATABASE_URL=pglite://./.data/kaname
# Production:
# DATABASE_URL=postgres://kaname:password@localhost:5432/kaname

# --- secrets ------------------------------------------------------
# REQUIRED in production. Wraps every per-row data key, so losing it
# means losing every stored credential. 32 bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# KANAME_MASTER_KEY=

# --- urls ---------------------------------------------------------
KANAME_PUBLIC_URL=http://localhost:3000
# Where agents dial. Usually the same origin behind the reverse proxy.
# KANAME_AGENT_URL=https://panel.example.com
KANAME_CONTROL_PLANE_URL=http://localhost:4000
PORT=4000

# --- first owner account ------------------------------------------
# BOTH must be set for an account to be seeded. With neither, a fresh
# instance lands in onboarding instead and prints a one-time setup token
# to the log, which is what a real install does.
# `pnpm dev:fleet` signs in with these to enroll the simulated agents,
# so in development set both. Never set them in production.
KANAME_BOOTSTRAP_EMAIL=owner@kaname.local
KANAME_BOOTSTRAP_PASSWORD=kaname-development-only

# --- first run ----------------------------------------------------
# Written by install.sh so the token it prints and the one the control
# plane accepts are the same. Generated on boot when absent.
# KANAME_SETUP_TOKEN=
# True when install.sh also paired an agent on this host; onboarding
# then waits for that agent instead of letting you past a dead one.
# KANAME_ALL_IN_ONE=false

# --- updates ------------------------------------------------------
# The version this build is. Set by the image; compared against the
# release manifest.
# KANAME_VERSION=0.1.0
# Where releases are published. Point it at your own mirror to run an
# air-gapped fleet.
# KANAME_UPDATE_MANIFEST_URL=https://raw.githubusercontent.com/FutureForge-Studios/kaname/main/versions.json
# Install root: secrets, rollback snapshots, the update queue, logs.
# KANAME_DATA_DIR=/etc/kaname
# `compose` lets the control plane update itself through the host unit
# install.sh sets up. Anything else and it says so rather than trying.
# KANAME_DEPLOYMENT=compose
# KANAME_COMPOSE_PROJECT=kaname

# --- sessions -----------------------------------------------------
SESSION_TTL_HOURS=336
# auto = the Secure flag and the __Host- prefix on requests that arrived
# over HTTPS, a plain cookie otherwise — so an install reached on both
# its IP address and a domain can sign in on either. true forces it
# everywhere (HTTPS-only deployments); false never sets it.
SECURE_COOKIES=auto

# --- agents -------------------------------------------------------
AGENT_HEARTBEAT_SECONDS=15
AGENT_OFFLINE_AFTER_SECONDS=60
AGENT_CERT_DAYS=90
ENROLLMENT_TOKEN_TTL_MINUTES=15
# Set to true ONLY when a reverse proxy you control forwards the agent's
# client certificate in x-kaname-client-cert.
# KANAME_TRUST_PROXY_CLIENT_CERT=false

# --- jobs ---------------------------------------------------------
JOB_WORKER_ENABLED=true
JOB_WORKER_CONCURRENCY=4
JOB_LEASE_SECONDS=60

# --- retention ----------------------------------------------------
RAW_METRICS_RETENTION_HOURS=48
METRICS_RETENTION_DAYS=90
# Finished jobs and their logs; expired or revoked sign-in sessions.
JOB_RETENTION_DAYS=30
SESSION_RETENTION_DAYS=7

# --- acme ---------------------------------------------------------
ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
# ACME_EMAIL=you@example.com

# --- logging ------------------------------------------------------
LOG_LEVEL=info
LOG_PRETTY=true
