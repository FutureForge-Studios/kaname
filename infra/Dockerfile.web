# ------------------------------------------------------------------
# Panel UI. Standalone Next output so the image stays small.
# ------------------------------------------------------------------
FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /app

FROM base AS deps
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* .npmrc ./
COPY packages/contract/package.json packages/contract/
COPY packages/db/package.json packages/db/
COPY packages/ui/package.json packages/ui/
COPY apps/control-plane/package.json apps/control-plane/
COPY apps/web/package.json apps/web/
RUN pnpm install --frozen-lockfile=false

FROM deps AS build
ARG KANAME_CONTROL_PLANE_URL=http://control-plane:4000
ENV KANAME_CONTROL_PLANE_URL=$KANAME_CONTROL_PLANE_URL
COPY . .
RUN pnpm --filter @kaname/web build

FROM base AS runtime
ENV NODE_ENV=production
RUN addgroup -S kaname && adduser -S kaname -G kaname
# The standalone bundle is rooted at the workspace, so server.js lands
# at apps/web/server.js with node_modules beside it. Static assets are
# not traced into it and have to come across separately. There is no
# apps/web/public: the icons are app-directory metadata files.
COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
USER kaname
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
