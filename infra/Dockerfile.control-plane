# ------------------------------------------------------------------
# Control plane. Bundled with tsup so the image carries no TypeScript
# toolchain and no workspace symlinks (KD-016).
#
# The agent binaries are built here too and served from this image, so
# the binary a new server installs comes from the same host that will
# manage it, over the same TLS.
# ------------------------------------------------------------------
FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /app

FROM base AS deps
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* .npmrc ./
COPY packages/contract/package.json packages/contract/
COPY packages/db/package.json packages/db/
COPY packages/ui/package.json packages/ui/
COPY apps/control-plane/package.json apps/control-plane/
COPY apps/web/package.json apps/web/
RUN pnpm install --frozen-lockfile=false

FROM deps AS build
COPY . .
RUN pnpm --filter @kaname/control-plane build

# Pinned to the build platform, not the target. One control plane hands
# out agents to hosts of both architectures, so an arm64 image that
# carried only an arm64 agent would be wrong; both are cross-compiled
# here whatever the image itself ends up running on.
FROM --platform=$BUILDPLATFORM golang:1.23-alpine AS agent
ARG KANAME_VERSION=0.1.0
WORKDIR /agent
COPY agent/go.mod agent/go.sum ./
RUN go mod download
COPY agent/ ./
# Stamped with the release, the same way release.yml stamps the assets:
# the control plane compares this string against the manifest to decide
# whether an agent update landed.
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags "-s -w -X main.version=${KANAME_VERSION}" -o /out/kanamed-linux-amd64 ./cmd/kanamed \
 && CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -trimpath -ldflags "-s -w -X main.version=${KANAME_VERSION}" -o /out/kanamed-linux-arm64 ./cmd/kanamed

FROM base AS runtime
ARG KANAME_VERSION=0.1.0
ENV NODE_ENV=production
ENV KANAME_VERSION=${KANAME_VERSION}

# A fixed uid, because install.sh hands this account ownership of the
# three paths under the data root the control plane has to write.
RUN addgroup -g 10001 -S kaname && adduser -u 10001 -S kaname -G kaname

COPY --from=build /app/apps/control-plane/dist ./dist
COPY --from=build /app/packages/db/drizzle ./drizzle
# Read at runtime, not bundled: the migrator resolves it beside its own
# module, which after bundling is dist/.
COPY --from=build /app/packages/db/src/hardening.sql ./dist/hardening.sql
COPY --from=build /app/node_modules ./node_modules
COPY --from=agent /out/ ./public/
COPY install.sh ./public/install.sh
# The tag's install.sh still pins the previous release (release.yml only
# moves the constant on main after the images exist), so the copy this
# panel serves is pointed at the version it is. Prereleases are left
# alone, mirroring release.yml.
RUN case "${KANAME_VERSION}" in *-*) ;; *) sed -i -E "s/^KANAME_DEFAULT_VERSION=\"[^\"]*\"/KANAME_DEFAULT_VERSION=\"${KANAME_VERSION}\"/" ./public/install.sh ;; esac

USER kaname
EXPOSE 4000
CMD ["node", "dist/main.js"]
